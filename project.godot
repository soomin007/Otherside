; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="See you on the other side"
config/description="비동기 로그라이트. 매년 원정대가 떠나고 거의 다 죽는다. 후대는 곧 나 자신이며, 죽기 전 단 한 번 미래의 나에게 물건을 남긴다."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.031, 0.027, 0.039, 1)
boot_splash/image="res://assets/arts/29_타이틀_키아트_가로.png"
config/icon="res://icon.svg"

[audio]

; 웹(Threads OFF) 메인스레드 오디오 버퍼 확대 — 기본 15ms 는 짧아 폰 브라우저에서 BGM 언더런('타닥' 클릭).
; 60ms → 약 4096샘플 버퍼(≈85ms). 웹 전용 override(데스크톱 무영향). 탭 SFX 지연이 거슬리면 낮추고,
; 그래도 타닥이 남으면 근본책은 thread_support ON(export_presets). (2026-07-06)
driver/output_latency.web=60

[autoload]

GameState="*res://scripts/GameState.gd"
Transition="*res://scripts/ui/Transition.gd"
Debug="*res://scripts/ui/DebugOverlay.gd"
Bookmark="*res://scripts/ui/Bookmark.gd"
Tutorial="*res://scripts/ui/Tutorial.gd"
Fullscreen="*res://scripts/ui/Fullscreen.gd"
AudioManager="*res://scripts/AudioManager.gd"

[display]

window/size/viewport_width=600
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/MaruBuri-Regular.ttf"
theme/default_font_size=24

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.066667, 0.070588, 0.094118, 1)
